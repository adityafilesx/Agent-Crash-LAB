# ============================================================
# AgentCrashLab — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# cp .env.example .env

# --- Database ---
POSTGRES_USER=agentcrash
POSTGRES_PASSWORD=agentcrash_dev
POSTGRES_DB=agentcrashlab
DATABASE_URL=postgresql://agentcrash:agentcrash_dev@db:5432/agentcrashlab

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- LLM Providers (optional — demo works without these) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Agent Defaults ---
DEFAULT_MODEL_PROVIDER=mock
DEFAULT_MODEL_NAME=gpt-4o

# --- Sandbox ---
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_TOOL_CALLS=20
